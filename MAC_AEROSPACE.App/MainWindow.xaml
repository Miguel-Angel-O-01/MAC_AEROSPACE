<Window x:Class="MAC_AEROSPACE.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MAC_AEROSPACE.App"
        Title="MAC AEROSPACE - Digital Twin MVP" Height="600" Width="1000">

    <Grid Background="#222222">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition/>

        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10,10,10,10">
            <TextBlock Text="Herramientas" Foreground="White" FontSize="18" Margin="0,0,0,20" FontWeight="Bold"/>
            <Button x:Name="BtnCargar" Content="Cargar Geometría" Padding="10" Margin="0,5" Click="BtnCargar_Click"/>
            <Button Content="Análisis Estructural" Padding="10" Margin="0,5"/>
        </StackPanel>

        <Border Grid.Column="1" BorderBrush="#444444" BorderThickness="2">
            <local:OcctViewHost x:Name="View3D"/>
        </Border>
    </Grid>
</Window>